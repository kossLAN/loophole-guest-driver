    <ClInclude Include="viogpu\common\viogpu.h" />
    <ClInclude Include="viogpu\common\viogpu_idr.h" />
    <ClInclude Include="viogpu\common\viogpu_pci.h" />
    <ClInclude Include="viogpu\common\viogpu_pnp_fixup.h" />
    <ClInclude Include="viogpu\common\viogpu_queue.h" />
    <ClInclude Include="viogpu\common\virgl_hw.h" />
    <ClInclude Include="viogpu\viogpudo\viogpudo.h" />
    <ClInclude Include="viogpu\viogpu3d\driver.h" />
    <ClInclude Include="viogpu\viogpu3d\trace.h" />
    <ClInclude Include="viogpu\viogpu3d\viogpu_adapter.h" />
    <ClInclude Include="viogpu\viogpu3d\viogpu_allocation.h" />
    <ClInclude Include="viogpu\viogpu3d\viogpu_command.h" />
    <ClInclude Include="viogpu\viogpu3d\viogpu_device.h" />
    <ClInclude Include="viogpu\viogpu3d\viogpu_ringfence.h" />
    <ClInclude Include="viogpu\viogpu3d\viogpu_vidpn.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="viogpu\viogpu3d\viogpu3d.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="viogpu3d.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="LoopholeVersionHeader" BeforeTargets="ResourceCompile">
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)loophole_version.h" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="#define LOOPHOLE_VERSION $(LoopholeVersion.Replace('.', ','));#define LOOPHOLE_VERSION_STR &quot;$(LoopholeVersion)&quot;" />
  </Target>
  <Target Name="LoopholeTestSign" AfterTargets="Link" Condition="'$(LoopholeTestSign)'=='true'">
    <Exec Command="&quot;$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\signtool.exe&quot; sign /q /fd SHA256 /f &quot;$(MSBuildThisFileDirectory)cert\loophole-test.pfx&quot; /p loophole &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
